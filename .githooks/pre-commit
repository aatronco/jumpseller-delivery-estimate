#!/bin/sh
# Blocks commits that include the merchant's name or anything that looks like a credential.
# Rules live outside the repo so the blocked name is never published.
PATTERNS="$HOME/.config/delivery-estimate/blocked-patterns"
[ -f "$PATTERNS" ] || { echo "pre-commit: missing $PATTERNS"; exit 1; }
if git diff --cached -U0 --no-color | grep '^+' | grep -v '^+++' | grep -i -E -f "$PATTERNS"; then
  echo "pre-commit: blocked content found (merchant name or credential). Commit aborted."; exit 1
fi
if git diff --cached --name-only | grep -i -E -f "$PATTERNS"; then
  echo "pre-commit: blocked word in a file name. Commit aborted."; exit 1
fi
